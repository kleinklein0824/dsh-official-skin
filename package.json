{
  "name": "dsh-official-skin",
  "version": "1.1.4",
  "description": "DeepSeek 官网风格皮肤：深蓝宇宙感背景（流体极光 + 粒子鲸鱼 + 星座网格）与浅色玻璃主题，右上角一键切换",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "skin",
    "theme",
    "webgl",
    "background"
  ],
  "license": "MIT",
  "author": "Klein",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleinklein0824/dsh-official-skin.git"
  },
  "homepage": "https://github.com/kleinklein0824/dsh-official-skin#readme",
  "bugs": {
    "url": "https://github.com/kleinklein0824/dsh-official-skin/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.5"
  }
}
